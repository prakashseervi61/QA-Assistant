# ---------------------------------------------------------------------------
# QA Assistant — environment configuration
#
# Copy this file to `.env` and fill in at least one LLM provider API key:
#     cp .env.example .env
#
# Every variable here is real and read by src/infrastructure/config/settings.py.
# Uncommented values are the recommended starting point; commented ones are
# the code defaults, shown so you can see what you are changing.
# ---------------------------------------------------------------------------

# --- Application -------------------------------------------------------------
APP_NAME=QA Assistant

# --- LLM Provider ------------------------------------------------------------
# Gemini is the only provider implemented. Adding one means writing the
# `LLMProvider` implementation and wiring it in app.py.
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Vector Store (ChromaDB) -------------------------------------------------
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=documents

# --- Conversation history (SQLite) ------------------------------------------
# Chat history is saved to this local file so it survives restarts: no
# database server required. If the file cannot be opened the app falls back
# to in-memory storage, and history will not survive a restart.
# HISTORY_DB_PATH=./data/history.db

# --- Runtime secrets ---------------------------------------------------------
# Where a Gemini API key entered via the Settings page is stored. A key set in
# the UI takes precedence over GEMINI_API_KEY above; clearing it in the UI falls
# back to the environment value. Plaintext on disk, same as .env — the API
# binds loopback only. Lives under data/, which is git-ignored.
# SECRETS_FILE_PATH=./data/secrets.json

# --- Document Processing -----------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
# Enforced on upload: anything larger is rejected with 413 before it is read
# into memory. Raise deliberately — the parser decompresses DOCX.
# MAX_FILE_SIZE_MB=50

# --- API ---------------------------------------------------------------------
# CORS_ORIGINS=["http://localhost:3000"]

# --- Usage Tracking ----------------------------------------------------------
# Records LLM token usage & cost and exposes GET /api/usage.
# On by default; set to false to disable in-memory accounting.
# ENABLE_USAGE_TRACKING=true

# --- Incremental Ingestion (optional, OFF by default) -------------------------
# When enabled, re-uploading a byte-identical file (same SHA-256 content
# hash) returns a "duplicate detected" result without re-parsing,
# re-embedding, or re-storing it. Hashes are stored in chunk metadata.
# ENABLE_INCREMENTAL_INGESTION=false

# --- Guardrails (ON by default, flag-only) ------------------------------------
# When enabled, the RAG pipeline checks the user question for PII and prompt
# injection before retrieval, and the generated answer for groundedness and
# PII leaks afterwards. Flagged queries are NEVER blocked unless
# GUARDRAIL_BLOCK_VIOLATIONS is true (flag-only by default).
# ENABLE_GUARDRAILS=true
# GUARDRAIL_BLOCK_VIOLATIONS=false
# GUARDRAIL_GROUNDEDNESS_THRESHOLD=0.2

# --- Prompt Versioning (optional) ---------------------------------------------
# PROMPT_VERSION selects the RAG system-prompt template registered in
# src/infrastructure/llm/prompt_registry.py ("v1" = the original template,
# byte-identical to the pre-versioning prompt). Unknown versions fall back
# to v1 with a logged warning, so the pipeline can never break.
# PROMPT_VERSION=v1
