# ---------------------------------------------------------------------------
# QA Assistant — environment configuration
#
# Copy this file to `.env` and fill in at least one LLM provider API key:
#     cp .env.example .env
#
# All variables are optional — the code defaults (src/infrastructure/config/
# settings.py) are shown as comments. Only the values below that are left
# uncommented define the recommended starting point.
# ---------------------------------------------------------------------------

# --- Application -------------------------------------------------------------
APP_NAME=QA Assistant
# DEBUG=false
# LOG_LEVEL=INFO

# --- LLM Provider ------------------------------------------------------------
# One of: gemini | openai | anthropic | deepseek   (default: gemini)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (alternative)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o

# Anthropic (alternative)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# DeepSeek (alternative)
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_MODEL=deepseek-v4-flash

# --- Embedding Provider ------------------------------------------------------
# One of: gemini | openai | huggingface
# `huggingface` runs locally — no API key needed. The model is downloaded on
# first use (~80-100 MB) and cached afterwards.
# Note: the code default is `gemini`; `huggingface` is used here for a
# zero-cost, keyless setup. Docker Compose also defaults to `huggingface`.
EMBEDDING_PROVIDER=huggingface
HUGGINGFACE_MODEL=all-MiniLM-L6-v2
# GEMINI_EMBEDDING_MODEL=text-embedding-004
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Vector Store (ChromaDB) -------------------------------------------------
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=documents

# --- Database (optional) -----------------------------------------------------
# Persist conversations in PostgreSQL instead of keeping them in memory.
# Requires the optional deps: pip install -e ".[postgres]"
# When unset, the app uses in-memory conversation storage.
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/qa_assistant

# --- Document Processing -----------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
# MAX_FILE_SIZE_MB=50                      # reserved — not enforced by the API
# ALLOWED_EXTENSIONS=[".pdf", ".docx", ".txt"]

# --- API ---------------------------------------------------------------------
# API_HOST=0.0.0.0                         # reserved — uvicorn is launched with an explicit host
# API_PORT=8000                            # reserved — uvicorn is launched with an explicit port
# CORS_ORIGINS=["http://localhost:3000"]

# --- Authentication (optional, OFF by default) --------------------------------
# When enabled, every API endpoint except /api/health requires a valid JWT
# bearer token (Authorization: Bearer <token>). Tokens are HMAC-SHA256
# signed with SECRET_KEY. SECRET_KEY MUST be overridden with a long random
# value in any production deployment; with ENABLE_AUTH=true the app refuses
# to start with the bundled dev default.
# AUTH_API_KEY enables POST /api/auth/token, which exchanges an API key
# for a short-lived JWT (useful for external/scripted clients). When
# AUTH_API_KEY is empty (the default) the token endpoint rejects all keys.
# ENABLE_AUTH=false
# SECRET_KEY=change-me-to-a-long-random-string
# AUTH_API_KEY=your_api_key_here
# ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Rate Limiting (optional, OFF by default) --------------------------------
# When enabled, each client IP is limited to RATE_LIMIT_MAX_REQUESTS
# requests per RATE_LIMIT_WINDOW_SECONDS using an in-memory sliding window
# (limits reset on server restart).
# Note: the limiter keys on the IP the app sees. Behind a reverse proxy
# that is the proxy's IP — deploy behind uvicorn directly, or add
# X-Forwarded-For handling later.
# ENABLE_RATE_LIMITING=false
# RATE_LIMIT_MAX_REQUESTS=60
# RATE_LIMIT_WINDOW_SECONDS=60

# --- Usage Tracking ----------------------------------------------------------
# Records LLM token usage & cost and exposes GET /api/usage.
# On by default; set to false to disable in-memory accounting.
# ENABLE_USAGE_TRACKING=true

# --- Incremental Ingestion (optional, OFF by default) -------------------------
# When enabled, re-uploading a byte-identical file (same SHA-256 content
# hash) returns a "duplicate detected" result without re-parsing,
# re-embedding, or re-storing it. Hashes are stored in chunk metadata.
# ENABLE_INCREMENTAL_INGESTION=false

# --- Observability / Tracing (Phoenix) ---------------------------------------
# Sends OpenTelemetry traces to the configured OTLP endpoint.
# Requires the optional tracing deps: pip install -e ".[tracing]"
# ENABLE_TRACING=false
# TRACING_ENDPOINT=http://localhost:6006/v1/traces
# TRACING_SERVICE_NAME=qa-assistant

# --- Guardrails (optional, OFF by default) ------------------------------------
# When enabled, the RAG pipeline checks the user question for PII and prompt
# injection before retrieval, and the generated answer for groundedness and
# PII leaks afterwards. Flagged queries are NEVER blocked unless
# GUARDRAIL_BLOCK_VIOLATIONS is true (flag-only by default).
# ENABLE_GUARDRAILS=false
# GUARDRAIL_BLOCK_VIOLATIONS=false
# GUARDRAIL_GROUNDEDNESS_THRESHOLD=0.2

# --- Prompt Versioning (optional) ---------------------------------------------
# PROMPT_VERSION selects the RAG system-prompt template registered in
# src/infrastructure/llm/prompt_registry.py ("v1" = the original template,
# byte-identical to the pre-versioning prompt). Unknown versions fall back
# to v1 with a logged warning, so the pipeline can never break.
# PROMPT_VERSION=v1
