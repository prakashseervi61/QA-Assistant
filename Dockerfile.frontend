# Build stage: compile the React + Vite frontend
FROM node:18-alpine AS build

WORKDIR /app

# Install dependencies (npm ci: package-lock.json is committed and in sync)
COPY src/presentation/react/package*.json ./
RUN npm ci

# Copy application source and build
COPY src/presentation/react/ ./
RUN npm run build

# Serve stage: nginx serves static assets and proxies /api/ to the backend
FROM nginx:1.25-alpine AS serve

COPY --from=build /app/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
